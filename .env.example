# FamilyClaw — private runtime config (Layer B). Copy outside the repo, never commit `.env`.
#
#   cp .env.example ~/.config/familyclaw/familyclaw.env
#   # edit paths and secrets
#
# Load (PowerShell):  . .\scripts\load-env.ps1 -Path $HOME\.config\familyclaw\familyclaw.env
# Load (bash):        set -a && source ~/.config/familyclaw/familyclaw.env && set +a

# --- Paths (required for persistent gateway) ---
FAMILYCLAW_PROFILE_DIR=
FAMILYCLAW_DATA_DIR=

# --- Agent (generic demo profile name = subdirectory under PROFILE_DIR) ---
FAMILYCLAW_AGENT_NAME=agent_a
FAMILYCLAW_GATEWAY_ADDR=127.0.0.1:8787

# --- Security ---
FAMILYCLAW_GATEWAY_TOKEN=
# Required when FAMILYCLAW_GATEWAY_ADDR is non-loopback (e.g. 0.0.0.0 in Docker).
# Loopback (127.0.0.1) may leave this empty for local eval; doctor warns.
# FAMILYCLAW_OPERATOR_ACL=1
# When set, also send X-FamilyClaw-Operator-Role: viewer|approver|admin

# --- Native OIDC (optional; half-config fails closed at serve) ---
# FAMILYCLAW_OIDC_ISSUER=https://idp.example/
# FAMILYCLAW_OIDC_AUDIENCE=familyclaw
# FAMILYCLAW_OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
# FAMILYCLAW_OIDC_HS256_SECRET=  # alternative to JWKS (tests / simple IdPs)

# --- Optional Postgres journal (feature familyclaw-durable/postgres) ---
# NOTE: library only — `serve` does not read DATABASE_URL and always opens a
# FileJournal. Usable today only by embedding familyclaw-durable yourself.
# DATABASE_URL=postgres://familyclaw:familyclaw@127.0.0.1:5432/familyclaw

# --- OTLP scaffolding (feature familyclaw-observability/otlp) ---
# Envelope + endpoint helper only — there is no network exporter, so setting
# this does not yet ship spans anywhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- Telegram (optional channel) ---
TELEGRAM_BOT_TOKEN=
FAMILYCLAW_TELEGRAM_CHANNEL_ID=tg-main
FAMILYCLAW_REPLY_TARGET=
FAMILYCLAW_CHANNEL_KIND=telegram

# --- Slack (optional channel; outbound-only MVP: chat.postMessage) ---
# No inbound path yet: no Events API / Socket Mode, and POST /inject is
# Discord-only. `doctor` does not know this channel kind yet either.
# SLACK_BOT_TOKEN=
# FAMILYCLAW_SLACK_CHANNEL_ID=C0123456789
# FAMILYCLAW_CHANNEL_KIND=slack

# --- Workspace tools = THE capability boundary ---
# These variables ARE the sandbox. `fs_read`, `file_write` and `shell_exec`
# stay registered even when the lists are empty — they then deny everything
# (fail-closed). An empty list is a locked-down deployment, not a broken one,
# and `/readyz` reports it under `degraded` so it never disappears silently.
# A list pointing at a directory that does NOT exist IS a failure: `/readyz`
# returns 503, because the skill is silently dead.
# Separator: ';' on Windows, ':' on Linux/macOS (platform PATH list).
# Prefer one dedicated agent workspace over a broad home directory.
FAMILYCLAW_FS_READ_ALLOW=
FAMILYCLAW_FILE_WRITE_ALLOW=
# Subset of the read roots the agent may treat as trusted input.
FAMILYCLAW_FS_READ_TRUSTED=
# shell_exec is deliberately stricter: off | manual | smart. Keep `manual` in
# production — `smart` lets the agent decide when to run a command.
FAMILYCLAW_SHELL_MODE=manual
# Semicolon-separated working-directory roots for shell_exec.
FAMILYCLAW_SHELL_CWD_ALLOWLIST=
# Run third-party skills only through the real wasmtime backend. The runtime
# fails closed if this is set but the binary was built without the feature.
FAMILYCLAW_SANDBOX_SKILLS=1
# Optional MCP servers: name=command args;name=http://127.0.0.1:PORT/mcp
FAMILYCLAW_MCP_SERVERS=

# --- Memory embeddings ---
# deterministic = dependency-free fallback (no network, no model download).
# ollama requires the `ollama` build feature AND a reachable local endpoint.
FAMILYCLAW_EMBED_PROVIDER=deterministic
FAMILYCLAW_EMBED_MODEL=nomic-embed-text
FAMILYCLAW_EMBED_URL=http://127.0.0.1:11434

# --- Shared memory surface (optional) ---
FAMILYCLAW_HEARTH_ENABLED=

# --- LLM providers (optional) ---
# The client speaks the OpenAI-compatible chat-completions API (POST {base}/chat/completions).
# Point this at any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local proxy, …).
# NOTE: a raw Anthropic base (https://api.anthropic.com/v1) does NOT work here — Anthropic
# uses /messages, not /chat/completions. Route Anthropic through an OpenAI-compatible proxy.
# Format: prefix=base-url=API_KEY_ENV — ';' separates providers, ',' separates
# several key env names for one provider.
FAMILYCLAW_PROVIDERS=openai=https://api.openai.com/v1=OPENAI_API_KEY
OPENAI_API_KEY=
# Model IDs MUST use provider/model form. A bare model name leaves the agent
# alive but mute: the endpoint resolver cannot pick a provider, and nothing
# crashes to tell you.
FAMILYCLAW_PROVIDER_MODEL=openai/gpt-4.1-mini
# Ordered fallback chain, comma-separated. Every entry needs provider/model too.
FAMILYCLAW_FALLBACK_MODELS=
# Per-request wall-clock bound in milliseconds.
FAMILYCLAW_REQUEST_TIMEOUT_MS=

# --- Discord (optional) ---
# Bot token → two-way mode (gateway listens AND posts). Preferred.
# If empty, the adapter falls back to send-only webhook posting (DISCORD_WEBHOOK_URL).
DISCORD_BOT_TOKEN=
# Numeric channel snowflake (required in bot mode). Webhook mode may use a label.
DISCORD_CHANNEL_ID=
# Webhook URL — send-only fallback when no bot token is set.
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=
# Optional: owner's Discord user id → enables a private DM channel with that user
# only (reply routes back to the DM). Unset/0/invalid = DMs dropped, group
# channel only (never "all DMs allowed"). Can also be set in familyclaw.toml as
# [channel.discord] owner_id = <id>; this env var overrides the TOML value.
FAMILYCLAW_OWNER_ID=

# --- LLM output length (optional) ---
# Max output tokens per completion. Default 4096 (raised from 2048 — that was
# cutting off longer replies mid-sentence). Applied to ALL resolved models.
FAMILYCLAW_MAX_TOKENS=
# Auto-continuation rounds when a reply is cut off by the token limit
# (finish_reason == "length"): each round appends the partial reply + a
# "continue" nudge and calls again, concatenating the result. Default 3;
# 0 disables continuation (a length-truncated reply then ships as-is).
FAMILYCLAW_MAX_CONTINUATIONS=
# Character cap per short-term-history message (user/assistant turns kept in
# context). Default 1500, minimum 200 (lower values are ignored). Raise this
# alongside FAMILYCLAW_MAX_TOKENS if the agent's own long replies need to stay
# in its conversational memory instead of being stunted to 1500 chars.
FAMILYCLAW_HISTORY_MAX_CHARS=

# --- Turn watchdog (optional) ---
# Soft deadline (seconds) for a single turn: past this, the user gets an
# interim "still working" notice but the turn keeps running (not dropped).
# Default 120. For heavy introspection prompts that legitimately take
# minutes, raise this, e.g. FAMILYCLAW_TURN_WATCHDOG_SECS=240.
FAMILYCLAW_TURN_WATCHDOG_SECS=
# Hard-cap multiplier: the turn is truly abandoned at
# FAMILYCLAW_TURN_WATCHDOG_SECS * this value. Default 3, minimum 1.
FAMILYCLAW_TURN_WATCHDOG_HARD_MULTIPLIER=

# --- Dream: prefer external cron in production ---
FAMILYCLAW_DREAM_DISABLED=1

RUST_LOG=info,familyclaw=debug
